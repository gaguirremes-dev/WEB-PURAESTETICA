# ============================================================
# .htaccess — Pura Estética
# ============================================================

Options -Indexes
ServerSignature Off

# ── HTTPS redirect ──────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www → non-www (ajustar según preferencia)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# ── Compresión GZIP ─────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2
</IfModule>

# ── Bloquear Bots Agresivos (Ahorro de Ancho de Banda) ─────
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Bloquear bots de IA que consumen muchos recursos sin aportar tráfico orgánico
  RewriteCond %{HTTP_USER_AGENT} ClaudeBot [NC,OR]
  RewriteCond %{HTTP_USER_AGENT} GPTBot [NC,OR]
  RewriteCond %{HTTP_USER_AGENT} CCBot [NC]
  RewriteRule .* - [F,L]
</IfModule>

# ── Caché de archivos (Optimización de Ancho de Banda) ────
<IfModule mod_headers.c>
  # 1. NO cachear HTML ni páginas dinámicas (para que siempre estén frescas)
  <FilesMatch "\.(html|htm|php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # 2. SÍ cachear imágenes, CSS, JS y fuentes (evita recargas y ahorra ancho de banda)
  <FilesMatch "\.(css|js|woff2|png|jpg|jpeg|gif|webp|svg|ico|mp4|webm)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>

  # Security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
</IfModule>

# ── Proteger archivos sensibles ──────────────────────────
<FilesMatch "\.(htaccess|htpasswd|env|json|yml|yaml|md|log|sh|sql)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# Bloquear archivos de desarrollo
<FilesMatch "(fix-servicios\.js|tailwind\.config\.js|tailwind-input\.css|package(-lock)?\.json)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# Permitir acceso a manifest y schema
<FilesMatch "(manifest\.json|schema\.json)$">
  Order Deny,Allow
  Allow from all
</FilesMatch>

# ── Custom error pages ───────────────────────────────────
ErrorDocument 404 /index.html
ErrorDocument 500 /index.html

# ── MIME types ───────────────────────────────────────────
<IfModule mod_mime.c>
  AddType font/woff2           .woff2
  AddType image/webp           .webp
  AddType video/mp4            .mp4
  AddType video/webm           .webm
  AddType application/manifest+json .webmanifest
</IfModule>
